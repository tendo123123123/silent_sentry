<launch>
  
    <let name="urdf_path" value="$(find-pkg-share bot_description)/urdf/bot.urdf.xacro" />
    <let name="gazebo_config_path" value="$(find-pkg-share bot_description)/config/gazebo_bridge.yaml" />
    <let name="pkg_share" value="$(find-pkg-share bot_description)" />

  
    <set_env name="GZ_SIM_RESOURCE_PATH"
             value="$(var pkg_share):$(var pkg_share)/models" />

    <set_env name="GZ_SIM_SYSTEM_PLUGIN_PATH" value="/opt/ros/jazzy/lib" />
    
    <set_env name="GZ_SIM_PHYSICS_ENGINE"
             value="gz-physics7-bullet-featherstone-plugin" />
    <set_env name="GZ_SIM_PHYSICS_ENGINE_PATH"
             value="/opt/ros/jazzy/opt/gz_physics_vendor/lib" />
             
    <set_env name="__GL_THREADED_OPTIMIZATIONS" value="1" />
    <set_env name="__GL_MaxFramesAllowed" value="1" />
    <set_env name="GZ_RENDERING_BACKEND" value="ogre2" />


    <executable
      cmd="taskset -c 0,1,2,3 gz sim -s -r $(var world_path)"
      output="screen" />
    <executable
      cmd="bash -c 'sleep 3 &amp;&amp; taskset -c 4,5 gz sim -g'"
      output="screen" />


    <node pkg="robot_state_publisher" exec="robot_state_publisher" launch-prefix="taskset -c 6,7">
        <param name="robot_description" value="$(command 'xacro $(var urdf_path)')" />
        <param name="use_sim_time" value="true" />
    </node>

    <node pkg="ros_gz_bridge" exec="parameter_bridge" launch-prefix="taskset -c 6,7">
        <param name="config_file" value="$(var gazebo_config_path)" />
        <param name="use_sim_time" value="true" />
    </node>

    <node pkg="ros_gz_sim" exec="create" 
          launch-prefix="bash -c 'sleep 5; taskset -c 6,7 $0 $@'"
          args="-world thar_desert -topic robot_description -name autobot -x 0 -y 0 -z 25" />

    <include file="$(find-pkg-share bot_controller)/launch/bot_controller.launch.py">
        <arg name="use_sim_time" value="True" />
    </include>

    <node pkg="rviz2" exec="rviz2"
          args="-d $(find-pkg-share bot_description)/config/gz.rviz"
          output="screen" 
          launch-prefix="taskset -c 6,7" />

</launch>
