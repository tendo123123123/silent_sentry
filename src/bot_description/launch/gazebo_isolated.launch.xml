<launch>

    <!-- World path argument (forwarded to world_only) -->
    <arg name="world_path" default="$(find-pkg-share bot_description)/worlds/thar_desert.sdf" />

    <!-- Simulation world (gz sim server + GUI + env vars) -->
    <include file="$(find-pkg-share bot_description)/launch/world_only.launch.xml">
        <arg name="world_path" value="$(var world_path)" />
    </include>

    <!-- Robot stack (RSP, bridge, spawner, controller, RViz) -->
    <include file="$(find-pkg-share bot_description)/launch/robot_only.launch.xml" />

</launch>
