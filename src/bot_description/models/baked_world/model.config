<?xml version="1.0"?>
<model>
  <name>terrain_with_vegetation</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>

  <author>
    <name>Silent Sentry Team</name>
    <email>team@silentempty.dev</email>
  </author>

  <description>
    Single baked GLB mesh containing all 1,500 vegetation instances
    (trees, shrubs, rocks) for the Thar Desert world.
    Static-only — no dynamics, no per-instance ECS overhead.
  </description>
</model>
