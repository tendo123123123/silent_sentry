<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ugv_localization</name>
  <version>1.0.0</version>
  <description>System-wide localization launch files, configs, and monitoring visualizer for UGV</description>
  <maintainer email="adi.pachauri.444@gmail.com">aditya-pachauri</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf_transformations</depend>
  <depend>robot_localization</depend>
  <depend>ugv_estimation</depend>
  <depend>ugv_local_dem</depend>
  <depend>ugv_trn</depend>
  <depend>ugv_terramechanics</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
