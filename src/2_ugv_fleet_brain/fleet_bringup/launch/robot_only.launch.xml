<launch>

    <!-- Fleet arguments -->
    <arg name="bot_name"    default="alpha" description="Robot namespace and Gazebo model name" />
    <arg name="x_pose"      default="0"     description="Spawn X coordinate" />
    <arg name="y_pose"      default="0"     description="Spawn Y coordinate" />
    <arg name="cpu_cores"   default="6,7"   description="CPU affinity for all robot nodes" />
    <arg name="launch_rviz" default="true" description="Launch RViz2 for this robot" />

    <!-- Robot model paths -->
    <let name="urdf_path" value="$(find-pkg-share bot_description)/urdf/bot.urdf.xacro" />

    <!-- Generate per-bot bridge config at launch time -->
    <let name="bridge_config_path"
         value="$(command 'python3 $(find-pkg-share fleet_bringup)/scripts/generate_bridge_config.py $(var bot_name)')" />

    <group>
        <push-ros-namespace namespace="$(var bot_name)" />

        <!-- Robot State Publisher -->
        <node pkg="robot_state_publisher" exec="robot_state_publisher"
              launch-prefix="taskset -c $(var cpu_cores)">
            <param name="robot_description"
                   value="$(command 'xacro $(var urdf_path) bot_name:=$(var bot_name)')" />
            <param name="use_sim_time" value="true" />
            <param name="frame_prefix" value="$(var bot_name)/" />
        </node>

        <!-- ROS ↔ Gazebo bridge (per-bot config generated at launch time) -->
        <node pkg="ros_gz_bridge" exec="parameter_bridge"
              launch-prefix="taskset -c $(var cpu_cores)">
            <param name="config_file" value="$(var bridge_config_path)" />
            <param name="use_sim_time" value="true" />
        </node>

        <!-- Spawn robot into world (delayed 5 s for server readiness) -->
        <node pkg="ros_gz_sim" exec="create"
              launch-prefix="bash -c 'sleep 5; taskset -c $(var cpu_cores) $0 $@'"
              args="-world thar_desert -topic robot_description -name $(var bot_name) -x $(var x_pose) -y $(var y_pose) -z 25" />

        <!-- Bot controller stack (native controller_manager + EMCON hardware interface) -->
        <include file="$(find-pkg-share bot_controller)/launch/bot_controller.launch.py">
            <arg name="use_sim_time" value="True" />
            <arg name="namespace"    value="$(var bot_name)" />
            <arg name="bot_name"     value="$(var bot_name)" />
            <arg name="diff_drive_controller" value="False" />
        </include>

        <!-- RViz2 (optional) -->
        <node pkg="rviz2" exec="rviz2"
              args="-d $(find-pkg-share bot_description)/config/gz.rviz"
              output="screen"
              launch-prefix="taskset -c $(var cpu_cores)"
              if="$(var launch_rviz)" />
    </group>

</launch>
