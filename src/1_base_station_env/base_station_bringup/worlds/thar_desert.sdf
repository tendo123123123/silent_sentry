<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="thar_desert">

    <physics name="100Hz" type="bullet">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
      <bullet>
        <solver><iters>50</iters><sor>1.3</sor></solver>
        <constraints>
          <cfm>0.0</cfm><erp>0.2</erp>
          <contact_surface_layer>0.001</contact_surface_layer>
          <split_impulse>true</split_impulse>
          <split_impulse_penetration_threshold>-0.001</split_impulse_penetration_threshold>
        </constraints>
      </bullet>
    </physics>

    <!-- Engine selected HERE, not via GZ_SIM_PHYSICS_ENGINE. The env var in
         world_only.launch.xml was not reaching the gz server, so gz silently
         fell back to its default (dartsim + ODE collision), which the entity
         inspector confirmed. The <engine><filename> child of the Physics
         system plugin is the highest-precedence, SDF-local selection and
         removes the env-propagation dependency. Unversioned name resolves to
         libgz-physics7-bullet-featherstone-plugin.so on Harmonic. -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
      <engine>
        <filename>gz-physics-bullet-featherstone-plugin</filename>
      </engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu">
      <initial_orientation_as_reference>true</initial_orientation_as_reference>
    </plugin>
    <plugin filename="gz-sim-navsat-system"
            name="gz::sim::systems::NavSat"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.90 0.85 0.75 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>10000</range>
        <constant>0.9</constant>
        <linear>0</linear>
        <quadratic>0</quadratic>
      </attenuation>
      <direction>-0.6 0.5 -0.62</direction>
      <intensity>1.0</intensity>
    </light>
    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 11.435 0 0 0</pose>
      <diffuse>0.35 0.32 0.28 1</diffuse>
      <specular>0.15 0.12 0.08 1</specular>
      <attenuation>
        <range>10000</range><constant>0.9</constant>
        <linear>0</linear><quadratic>0</quadratic>
      </attenuation>
      <direction>0.4 -0.3 -0.5</direction>
    </light>

    <!-- ═══════════════════════════════════════════════════════════════════
         Scene
         ═══════════════════════════════════════════════════════════════════ -->
    <scene>
      <ambient>0.55 0.52 0.45 1</ambient>
      <background>0.72 0.78 0.88 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
      <sky>
        <time>10</time>
        <sunrise>5.5</sunrise>
        <sunset>19.5</sunset>
        <clouds>
          <speed>6</speed>
          <mean_size>0.3</mean_size>
          <ambient>0.9 0.9 0.9 1</ambient>
        </clouds>
      </sky>
    </scene>


    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>-24.19083332222223</latitude_deg>
      <longitude_deg>15.639166655555545</longitude_deg>
      <elevation>42</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <include>
      <uri>model://baked_world</uri>
      <name>terrain_with_vegetation</name>
      <pose>0 0 0 1.57 0 0</pose>
      <static>true</static>
    </include>

  </world>
</sdf>